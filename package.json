{
  "name": "kempo-payouts",
  "version": "0.1.1",
  "description": "Let users of a kempo site receive money from other users through Stripe Connect, with a fee for the site, without the site ever holding the funds",
  "license": "MIT",
  "author": "Dustin Poissant",
  "type": "module",
  "main": "sdk.js",
  "scripts": {
    "test": "node scripts/run-tests.js unit kempo-test -l minimal",
    "test:integration": "node scripts/run-tests.js integration kempo-test -l minimal -t 120000",
    "link:local": "node scripts/link-local.js"
  },
  "exports": {
    "./install": "./install.js",
    "./update": "./update.js",
    "./uninstall": "./uninstall.js",
    "./sdk": "./sdk.js"
  },
  "files": [
    "admin",
    "hooks",
    "public",
    "server",
    "install.js",
    "update.js",
    "uninstall.js",
    "sdk.js",
    "kempo-config.json"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dustinpoissant/kempo-payouts.git"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "stripe": "^22.5.0"
  },
  "peerDependencies": {
    "kempo": ">=4.7.0",
    "kempo-payments": ">=0.2.0",
    "kempo-server": ">=3.3.0",
    "kempo-ui": ">=0.6.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.9",
    "drizzle-kit": "^0.31.10",
    "kempo-testing-framework": "^1.4.11",
    "playwright": "^1.64.0",
    "postgres": "^3.4.9"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "puppeteer@25.7.0": true
  }
}
